# 복사해서 .env 로 만들고 값을 채운다:  cp .env.example .env

# --- Notion ---
# https://www.notion.so/profile/integrations 에서 "내부 통합" 생성 → 시크릿 복사
NOTION_TOKEN=

# --- Instagram (Meta 앱 생성 후) ---
# Meta 앱 대시보드 → Instagram API → "액세스 토큰 생성"에서 받은 장기 토큰과 IG 사용자 ID
IG_USER_ID=
IG_ACCESS_TOKEN=

# --- Claude Code (claude -p) ---
# cron 같은 무인 실행용 장기 토큰. 터미널에서 `claude setup-token` 실행 → 브라우저 로그인 → 출력된 토큰을 넣는다.
# 비워 두면 Claude Code의 현재 로그인을 쓰지만, 그 로그인은 만료될 수 있다.
CLAUDE_CODE_OAUTH_TOKEN=
